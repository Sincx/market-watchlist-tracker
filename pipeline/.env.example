# ── Google Sheets ──────────────────────────────────────────────────────────────
# Path to the service account JSON key file.
# Same account as the gsheets MCP: sheets-claude-mcp@technical-analysis-claude.iam.gserviceaccount.com
# Download from GCP Console → IAM → Service Accounts → Keys → Add Key → JSON
GOOGLE_SERVICE_ACCOUNT_JSON=C:\Users\Mike\.claude\credentials\gsheets-service-account.json

# ── Polygon.io (Massive) ───────────────────────────────────────────────────────
# API key — same one used by the Massive MCP server (check claude MCP settings)
POLYGON_API_KEY=your_polygon_api_key_here

# "free" = 5 req/min (13s sleep between calls)
# "paid" = unlimited (no sleep, parallel calls enabled)
POLYGON_TIER=free

# ── Alpha Vantage ──────────────────────────────────────────────────────────────
# Same key as AV MCP (check claude MCP settings)
ALPHA_VANTAGE_API_KEY=your_av_api_key_here

# ── Pipeline behaviour ─────────────────────────────────────────────────────────
# Comma-separated tickers to skip (temporary disable without touching Watchlist)
SKIP_TICKERS=

# Set to 1 to print verbose per-ticker progress to stdout
VERBOSE=0
